rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isProviderRole(role) {
      return role == 'hospital' ||
        role == 'bloodBank' ||
        role == 'oxygenProvider' ||
        role == 'ambulanceProvider' ||
        role == 'doctor';
    }

    function isProvider() {
      return isSignedIn() && isProviderRole(getUserData().role);
    }

    // Users Collection: users can read and edit their own doc, admins can read/manage all
    // Enforces zero-trust: non-admins CANNOT self-assign or modify role to 'admin' or provider
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin' && !isProviderRole(request.resource.data.role);
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || resource.data.role == request.resource.data.role)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Patient Links: attendants link and assist specific patients
    // Explicit Patient Consent (consentGranted == true, consentStatus == 'granted') is REQUIRED
    match /patientLinks/{linkId} {
      allow read: if isSignedIn() && (
        resource.data.attendantUid == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        (request.resource.data.attendantUid == request.auth.uid || request.resource.data.patientUid == request.auth.uid) &&
        request.resource.data.consentGranted == true &&
        request.resource.data.consentStatus == 'granted'
      );
      allow update: if isSignedIn() && (
        resource.data.attendantUid == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.attendantUid == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
    }

    function hasValidPatientConsent(attendantUid, patientUid) {
      let linkPath = /databases/$(database)/documents/patientLinks/$(attendantUid + '_' + patientUid);
      return exists(linkPath) &&
        get(linkPath).data.consentGranted == true &&
        get(linkPath).data.consentStatus == 'granted' &&
        get(linkPath).data.attendantUid == attendantUid &&
        get(linkPath).data.patientUid == patientUid;
    }

    // Emergency Cases: Patients/Attendants create cases, authorized participants, assigned providers, and admins can read/update
    match /cases/{caseId} {
      allow read: if isSignedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.attendantUid == request.auth.uid ||
        (resource.data.attendant != null && resource.data.attendant.uid == request.auth.uid) ||
        resource.data.requesterUid == request.auth.uid ||
        resource.data.assignedHospitalUid == request.auth.uid ||
        resource.data.assignedBloodBankUid == request.auth.uid ||
        resource.data.assignedOxygenUid == request.auth.uid ||
        resource.data.assignedAmbulanceUid == request.auth.uid ||
        isProvider() ||
        isAdmin()
      );
      // Case Creation:
      // 1. Patient creating an emergency request for themselves (patientUid == auth.uid)
      // 2. Authorized Patient Attendant creating for a linked patient ONLY when valid patient consent exists
      // 3. Central admin
      allow create: if isSignedIn() && (
        (request.resource.data.patientUid == request.auth.uid) ||
        (
          (request.resource.data.attendantUid == request.auth.uid ||
           (request.resource.data.attendant != null && request.resource.data.attendant.uid == request.auth.uid) ||
           request.resource.data.requesterUid == request.auth.uid) &&
          hasValidPatientConsent(request.auth.uid, request.resource.data.patientUid)
        ) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.attendantUid == request.auth.uid ||
        resource.data.requesterUid == request.auth.uid ||
        resource.data.assignedHospitalUid == request.auth.uid ||
        resource.data.assignedBloodBankUid == request.auth.uid ||
        resource.data.assignedOxygenUid == request.auth.uid ||
        resource.data.assignedAmbulanceUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Resource Requests: Patient, Attendant, and recipient provider can access and update
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.attendantUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.patientUid == request.auth.uid ||
        request.resource.data.attendantUid == request.auth.uid ||
        hasValidPatientConsent(request.auth.uid, request.resource.data.patientUid) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.providerUid == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.attendantUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Provider Specific Profiles: Publicly readable for authenticated users (search/directory)
    match /hospitalProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /bloodBankProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /oxygenProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /ambulanceProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Ambulance Trips: Tracked during emergency dispatch
    match /ambulanceTrips/{tripId} {
      allow read, write: if isSignedIn();
    }

    // Notifications: Recipient can read/update read state
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Clinical Notes: Recorded by attending physicians
    match /clinicalNotes/{noteId} {
      allow read, write: if isSignedIn();
    }
  }
}
