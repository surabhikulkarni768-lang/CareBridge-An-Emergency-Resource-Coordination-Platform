rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {
            'role': null,
            'isActive': false,
            'isVerified': false
          };
    }

    function isAdmin() {
      return isSignedIn() &&
        ('role' in getUserData()) &&
        getUserData().role == 'admin';
    }

    function isProviderRole(role) {
      return role == 'hospital' ||
        role == 'bloodBank' ||
        role == 'oxygenProvider' ||
        role == 'ambulanceProvider' ||
        role == 'doctor';
    }

    function hasAttendantConsent(caseData) {
      return ('attendant' in caseData) &&
        caseData.attendant is map &&
        ('relation' in caseData.attendant) &&
        (caseData.attendant.relation == 'Self' ||
         (request.auth != null &&
          ('attendantConsent' in caseData) &&
          caseData.attendantConsent is map &&
          ('granted' in caseData.attendantConsent) &&
          ('givenByUid' in caseData.attendantConsent) &&
          caseData.attendantConsent.granted == true &&
          caseData.attendantConsent.givenByUid == request.auth.uid));
    }

    function isAuthorizedPatient(patientUid) {
      let userPath = /databases/$(database)/documents/users/$(patientUid);
      return isSignedIn() &&
        request.auth.uid == patientUid &&
        exists(userPath) &&
        ('role' in get(userPath).data) &&
        get(userPath).data.role == 'patient';
    }

    function hasActiveAttendantConsent(patientUid) {
      return isSignedIn() &&
        patientUid is string &&
        exists(/databases/$(database)/documents/users/$(patientUid)/attendants/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(patientUid)/attendants/$(request.auth.uid)).data.keys().hasAll([
          'patientUid',
          'attendantUid',
          'activeConsent'
        ]) &&
        get(/databases/$(database)/documents/users/$(patientUid)/attendants/$(request.auth.uid)).data.patientUid == patientUid &&
        get(/databases/$(database)/documents/users/$(patientUid)/attendants/$(request.auth.uid)).data.attendantUid == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(patientUid)/attendants/$(request.auth.uid)).data.activeConsent == true;
    }

    function hasAssignedRequest(caseId, resourceType) {
      let requestPath = /databases/$(database)/documents/requests/$(('REQ-' + caseId) + '-' + resourceType);
      return exists(requestPath) &&
        ('providerUid' in get(requestPath).data) &&
        get(requestPath).data.providerUid == request.auth.uid;
    }

    function isAssignedProvider(caseId) {
      return isSignedIn() &&
        ('role' in getUserData()) &&
        getUserData().role != null &&
        (
          (getUserData().role == 'hospital' &&
           (hasAssignedRequest(caseId, 'bed') || hasAssignedRequest(caseId, 'icu'))) ||
          (getUserData().role == 'bloodBank' && hasAssignedRequest(caseId, 'blood')) ||
          (getUserData().role == 'oxygenProvider' && hasAssignedRequest(caseId, 'oxygen')) ||
          (getUserData().role == 'ambulanceProvider' && hasAssignedRequest(caseId, 'ambulance')) ||
          (getUserData().role == 'doctor' && hasAssignedRequest(caseId, 'doctor'))
        );
    }

    function providerCanReceiveResourceRequest(providerUid, resourceType) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let userPath = /databases/$(database)/documents/users/$(providerUid);
      let provider = get(directoryPath).data;
      let providerUser = get(userPath).data;
      return provider.keys().hasAll(['role', 'isActive', 'isVerified']) &&
        providerUser.keys().hasAll(['role', 'isActive', 'isVerified']) &&
        provider.isActive == true &&
        provider.isVerified == true &&
        providerUser.isActive == true &&
        providerUser.isVerified == true &&
        provider.role == providerUser.role &&
        (
          ((resourceType == 'bed' || resourceType == 'icu') && provider.role == 'hospital') ||
          (resourceType == 'blood' && provider.role == 'bloodBank') ||
          (resourceType == 'oxygen' && provider.role == 'oxygenProvider') ||
          (resourceType == 'ambulance' && provider.role == 'ambulanceProvider') ||
          (resourceType == 'doctor' && provider.role == 'doctor')
        );
    }

    function canReceiveResourceRequest(providerUid, resourceType) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let userPath = /databases/$(database)/documents/users/$(providerUid);
      return exists(directoryPath) &&
        exists(userPath) &&
        providerCanReceiveResourceRequest(providerUid, resourceType);
    }

    function isProvider() {
      return isSignedIn() &&
        ('role' in getUserData()) &&
        (
        getUserData().role == 'hospital' ||
        getUserData().role == 'bloodBank' ||
        getUserData().role == 'oxygenProvider' ||
        getUserData().role == 'ambulanceProvider' ||
        getUserData().role == 'doctor'
      );
    }

    // Users Collection: users can read and edit their own doc, admins can read/manage all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['uid', 'role', 'isVerified']) &&
        request.resource.data.uid == userId &&
        request.resource.data.role != 'admin' &&
        (!isProviderRole(request.resource.data.role) || request.resource.data.isVerified == false);
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'displayName',
           'phone',
           'city',
           'state',
           'address',
           'profileComplete',
           'updatedAt',
           'hospitalAffiliation'
         ]) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isVerified == resource.data.isVerified);
      allow delete: if isAdmin();

      match /attendants/{attendantUid} {
        allow read: if isOwner(userId) ||
          (isSignedIn() &&
           request.auth.uid == attendantUid &&
           resource.data.keys().hasAll(['attendantUid', 'activeConsent']) &&
           resource.data.attendantUid == request.auth.uid &&
           resource.data.activeConsent == true);
        allow create: if isAuthorizedPatient(userId) &&
          request.resource.data.keys().hasAll([
            'patientUid',
            'attendantUid',
            'activeConsent'
          ]) &&
          request.resource.data.patientUid == userId &&
          request.resource.data.attendantUid == attendantUid &&
          request.resource.data.activeConsent == true &&
          attendantUid != userId &&
          exists(/databases/$(database)/documents/users/$(attendantUid)) &&
          get(/databases/$(database)/documents/users/$(attendantUid)).data.role == 'patient';
        allow update: if isAuthorizedPatient(userId) &&
          resource.data.keys().hasAll(['patientUid', 'attendantUid']) &&
          request.resource.data.keys().hasAll(['patientUid', 'attendantUid']) &&
          resource.data.patientUid == userId &&
          resource.data.attendantUid == attendantUid &&
          request.resource.data.patientUid == userId &&
          request.resource.data.attendantUid == attendantUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activeConsent',
            'grantedAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /{path=**}/attendants/{attendantUid} {
      allow list: if isSignedIn() &&
        resource.data.get('attendantUid', '') == request.auth.uid &&
        resource.data.get('activeConsent', false) == true;
    }

    // Stores a minimal public directory record rather than exposing private user documents.
    match /providerDirectory/{providerUid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isOwner(providerUid) &&
         getUserData().keys().hasAll(['role', 'isVerified', 'isActive']) &&
         request.resource.data.uid == providerUid &&
         isProviderRole(getUserData().role) &&
         request.resource.data.role == getUserData().role &&
         request.resource.data.isVerified == getUserData().isVerified &&
         request.resource.data.isActive == getUserData().isActive);
      allow update: if isAdmin() ||
        (isOwner(providerUid) &&
         getUserData().keys().hasAll(['role', 'isVerified', 'isActive']) &&
         request.resource.data.uid == providerUid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isVerified == resource.data.isVerified &&
         request.resource.data.isVerified == getUserData().isVerified &&
         request.resource.data.isActive == getUserData().isActive);
      allow delete: if isAdmin();
    }

    // Emergency Cases: Patients, linked attendants, assigned providers, and admins can read
    match /cases/{caseId} {
      allow get: if isSignedIn() &&
        (!exists(/databases/$(database)/documents/cases/$(caseId)) ||
         isAdmin() ||
         (('patientUid' in resource.data) &&
          (isOwner(resource.data.patientUid) ||
           hasActiveAttendantConsent(resource.data.patientUid))) ||
         isAssignedProvider(caseId));
      allow list: if isSignedIn() &&
        (isAdmin() ||
         (('patientUid' in resource.data) &&
          (isOwner(resource.data.patientUid) ||
           hasActiveAttendantConsent(resource.data.patientUid))) ||
         isAssignedProvider(caseId));
      allow create: if request.resource.data.keys().hasAll([
          'patientUid',
          'caseId',
          'attendant'
        ]) &&
        isAuthorizedPatient(request.resource.data.patientUid) &&
        request.resource.data.caseId == caseId &&
        hasAttendantConsent(request.resource.data);
      allow update: if isAdmin() ||
        (('patientUid' in resource.data) &&
         isOwner(resource.data.patientUid) &&
         request.resource.data.keys().hasAll(['patientUid', 'status']) &&
         request.resource.data.patientUid == resource.data.patientUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status',
           'updatedAt'
         ]) &&
         request.resource.data.status in ['active', 'resolved', 'cancelled']);
      allow delete: if isAdmin();
    }

    // Resource Requests: Patients, linked attendants, recipient providers, and admins can access
    match /requests/{requestId} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (resource.data.keys().hasAll(['patientUid', 'providerUid']) &&
          (isOwner(resource.data.patientUid) ||
           hasActiveAttendantConsent(resource.data.patientUid) ||
           resource.data.providerUid == request.auth.uid)));
      allow create: if request.resource.data.keys().hasAll([
          'patientUid',
          'requesterUid',
          'caseId',
          'resourceType',
          'providerUid',
          'status'
        ]) &&
        isAuthorizedPatient(request.resource.data.patientUid) &&
        request.resource.data.patientUid == request.auth.uid &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)) &&
        getAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.patientUid == request.auth.uid &&
        hasAttendantConsent(getAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data) &&
        canReceiveResourceRequest(request.resource.data.providerUid, request.resource.data.resourceType);
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Provider Specific Profiles: Publicly readable for authenticated users (search/directory)
    match /hospitalProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /bloodBankProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /oxygenProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /ambulanceProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Ambulance Trips: Tracked during emergency dispatch
    match /ambulanceTrips/{tripId} {
      allow read, write: if isSignedIn();
    }

    // Notifications: Recipient can read/update read state
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Clinical Notes: Recorded by attending physicians
    match /clinicalNotes/{noteId} {
      allow read, write: if isSignedIn();
    }
  }
}
