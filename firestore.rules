rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function getUserData() {
      let uid = request.auth != null ? request.auth.uid : '';
      let path = userPath(uid);
      return isSignedIn() && exists(path)
        ? get(path).data
        : {
            'role': null,
            'isActive': false,
            'isVerified': false
          };
    }

    function isAdmin() {
      let user = getUserData();
      return isSignedIn() &&
        user.get('role', '') == 'admin' &&
        user.get('isActive', false) == true;
    }

    function isProviderRole(role) {
      return role == 'hospital' ||
        role == 'bloodBank' ||
        role == 'oxygenProvider' ||
        role == 'ambulanceProvider' ||
        role == 'doctor';
    }

    function isAttendantRole(role) {
      return role == 'patientAttendant' ||
        role == 'patient_attendant' ||
        role == 'attendant';
    }

    function isAuthorizedPatient(patientUid) {
      let path = userPath(patientUid);
      return isSignedIn() &&
        request.auth.uid == patientUid &&
        exists(path) &&
        get(path).data.get('role', '') == 'patient' &&
        get(path).data.get('isActive', false) == true;
    }

    function hasPatientLinkConsent(attendantUid, patientUid) {
      let path = /databases/$(database)/documents/patientLinks/$(attendantUid + '_' + patientUid);
      return isSignedIn() &&
        exists(path) &&
        get(path).data.get('attendantUid', '') == attendantUid &&
        get(path).data.get('patientUid', '') == patientUid &&
        get(path).data.get('consentGranted', false) == true &&
        get(path).data.get('consentStatus', '') == 'granted';
    }

    function hasActiveAttendantConsent(patientUid) {
      let attendantUid = request.auth != null ? request.auth.uid : '';
      let path = /databases/$(database)/documents/users/$(patientUid)/attendants/$(attendantUid);
      return isSignedIn() &&
        patientUid is string &&
        exists(path) &&
        get(path).data.get('patientUid', '') == patientUid &&
        get(path).data.get('attendantUid', '') == request.auth.uid &&
        get(path).data.get('activeConsent', false) == true;
    }

    function isAuthorizedAttendantForPatient(patientUid) {
      return isSignedIn() &&
        isAttendantRole(getUserData().get('role', '')) &&
        getUserData().get('isActive', false) == true &&
        (hasPatientLinkConsent(request.auth.uid, patientUid) ||
         hasActiveAttendantConsent(patientUid));
    }

    function hasAssignedRequest(caseId, resourceType) {
      let path = /databases/$(database)/documents/requests/$(('REQ-' + caseId) + '-' + resourceType);
      return isSignedIn() &&
        exists(path) &&
        get(path).data.get('providerUid', '') == request.auth.uid;
    }

    function providerIsVerifiedAndActive(providerUid) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let profilePath = userPath(providerUid);
      return exists(directoryPath) &&
        exists(profilePath) &&
        get(directoryPath).data.get('uid', '') == providerUid &&
        get(directoryPath).data.get('isActive', false) == true &&
        get(directoryPath).data.get('isVerified', false) == true &&
        get(profilePath).data.get('isActive', false) == true &&
        get(profilePath).data.get('isVerified', false) == true &&
        get(directoryPath).data.get('role', '') == get(profilePath).data.get('role', '');
    }

    function isAssignedProvider(caseId) {
      let role = getUserData().get('role', '');
      let casePath = /databases/$(database)/documents/cases/$(caseId);
      return isSignedIn() &&
        isProviderRole(role) &&
        exists(casePath) &&
        providerIsVerifiedAndActive(request.auth.uid) &&
        (
          (role == 'hospital' &&
           (hasAssignedRequest(caseId, 'bed') ||
            hasAssignedRequest(caseId, 'icu') ||
            hasAssignedRequest(caseId, 'hospital_admission'))) ||
          (role == 'bloodBank' && hasAssignedRequest(caseId, 'blood')) ||
          (role == 'oxygenProvider' && hasAssignedRequest(caseId, 'oxygen')) ||
          (role == 'ambulanceProvider' && hasAssignedRequest(caseId, 'ambulance')) ||
          (role == 'doctor' &&
           (hasAssignedRequest(caseId, 'doctor') || hasAssignedRequest(caseId, 'doctor_assistance')))
        );
    }

    function providerCanReceiveResourceRequest(providerUid, resourceType) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let profilePath = userPath(providerUid);
      return exists(directoryPath) &&
        exists(profilePath) &&
        get(directoryPath).data.get('uid', '') == providerUid &&
        get(directoryPath).data.get('isActive', false) == true &&
        get(directoryPath).data.get('isVerified', false) == true &&
        get(profilePath).data.get('isActive', false) == true &&
        get(profilePath).data.get('isVerified', false) == true &&
        get(directoryPath).data.get('role', '') == get(profilePath).data.get('role', '') &&
        (
          ((resourceType == 'bed' || resourceType == 'icu') && get(profilePath).data.get('role', '') == 'hospital') ||
          (resourceType == 'blood' && get(profilePath).data.get('role', '') == 'bloodBank') ||
          (resourceType == 'oxygen' && get(profilePath).data.get('role', '') == 'oxygenProvider') ||
          (resourceType == 'ambulance' && get(profilePath).data.get('role', '') == 'ambulanceProvider') ||
          (resourceType == 'doctor' && get(profilePath).data.get('role', '') == 'doctor')
        );
    }

    function canReceiveResourceRequest(providerUid, resourceType) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let profilePath = userPath(providerUid);
      return exists(directoryPath) &&
        exists(profilePath) &&
        providerCanReceiveResourceRequest(providerUid, resourceType);
    }

    function canSubmitForPatient(patientUid) {
      return isAuthorizedPatient(patientUid) ||
        isAuthorizedAttendantForPatient(patientUid);
    }

    function canReadCase(caseData) {
      let patientUid = caseData.get('patientUid', '');
      return isAdmin() ||
        (isSignedIn() && patientUid == request.auth.uid) ||
        isAuthorizedAttendantForPatient(patientUid) ||
        isAssignedProvider(caseData.get('caseId', ''));
    }

    function providerRoleMatchesResource(providerRole, resourceType) {
      return (((resourceType == 'bed' || resourceType == 'icu' || resourceType == 'hospital_admission') &&
          providerRole == 'hospital') ||
        (resourceType == 'blood' && providerRole == 'bloodBank') ||
        (resourceType == 'oxygen' && providerRole == 'oxygenProvider') ||
        (resourceType == 'ambulance' && providerRole == 'ambulanceProvider') ||
        ((resourceType == 'doctor' || resourceType == 'doctor_assistance') && providerRole == 'doctor'));
    }

    function validAssignmentProvider(providerUid, resourceType) {
      let directoryPath = /databases/$(database)/documents/providerDirectory/$(providerUid);
      let profilePath = userPath(providerUid);
      return exists(directoryPath) &&
        exists(profilePath) &&
        get(directoryPath).data.get('uid', '') == providerUid &&
        get(directoryPath).data.get('isActive', false) == true &&
        get(directoryPath).data.get('isVerified', false) == true &&
        get(profilePath).data.get('isActive', false) == true &&
        get(profilePath).data.get('isVerified', false) == true &&
        get(directoryPath).data.get('role', '') == get(profilePath).data.get('role', '') &&
        providerRoleMatchesResource(get(profilePath).data.get('role', ''), resourceType);
    }

    function validCaseLifecycleTransition(previousStatus, nextStatus) {
      return
        ((previousStatus in ['REQUESTED', 'Submitted', 'active'] &&
          nextStatus in ['UNDER_REVIEW', 'REJECTED', 'CANCELLED'])) ||
        ((previousStatus in ['UNDER_REVIEW', 'Under Review'] &&
          nextStatus in ['ASSIGNED', 'REJECTED', 'CANCELLED'])) ||
        (previousStatus == 'ASSIGNED' &&
          nextStatus in ['UNDER_REVIEW', 'ACCEPTED', 'REJECTED', 'CANCELLED']) ||
        (previousStatus == 'ACCEPTED' &&
          nextStatus in ['RESOURCE_CONFIRMED', 'REJECTED', 'CANCELLED']) ||
        (previousStatus == 'RESOURCE_CONFIRMED' &&
          nextStatus in ['DISPATCHED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED']) ||
        (previousStatus == 'DISPATCHED' &&
          nextStatus in ['IN_PROGRESS', 'COMPLETED', 'CANCELLED']) ||
        (previousStatus == 'IN_PROGRESS' &&
          nextStatus in ['COMPLETED', 'CANCELLED']);
    }

    function validRequestLifecycleTransition(previousStatus, nextStatus) {
      return
        ((previousStatus in ['pending', 'REQUESTED', 'requested'] &&
          nextStatus == 'ASSIGNED') ||
         (previousStatus in ['ASSIGNED', 'accepted', 'ACCEPTED', 'rejected', 'REJECTED'] &&
          nextStatus == 'ASSIGNED') ||
         (previousStatus in ['ASSIGNED', 'pending', 'REQUESTED', 'requested'] &&
          nextStatus in ['ACCEPTED', 'REJECTED']) ||
         (previousStatus in [
            'REQUESTED', 'requested', 'pending', 'ASSIGNED',
            'ACCEPTED', 'accepted'
          ] &&
          nextStatus in ['REJECTED', 'CANCELLED']) ||
         (previousStatus in ['ACCEPTED', 'accepted'] &&
          nextStatus in ['RESOURCE_CONFIRMED', 'DISPATCHED', 'IN_PROGRESS', 'COMPLETED']));
    }

    function validHistoryAppend(beforeData, afterData, historyField, eventId, eventType, previousStatus, nextStatus) {
      let beforeHistory = beforeData.get(historyField, {});
      let afterHistory = afterData.get(historyField, {});
      let changes = afterHistory.diff(beforeHistory);
      let event = afterHistory.get(eventId, {});
      return beforeHistory is map &&
        afterHistory is map &&
        eventId is string &&
        eventId.size() > 0 &&
        changes.addedKeys().hasOnly([eventId]) &&
        changes.addedKeys().hasAll([eventId]) &&
        changes.affectedKeys().hasOnly([eventId]) &&
        event.get('eventId', '') == eventId &&
        event.get('eventType', '') == eventType &&
        event.get('previousStatus', '') == previousStatus &&
        event.get('newStatus', '') == nextStatus &&
        event.get('updatedByUid', '') == request.auth.uid &&
        event.get('userRole', '') == getUserData().get('role', '') &&
        event.get('timestamp', null) == request.time;
    }

    function validCaseLifecycleReason(afterData, event, nextStatus) {
      let reason = event.get('reason', '');
      return (nextStatus == 'REJECTED' &&
          reason is string &&
          reason.size() >= 5 &&
          afterData.get('rejectionReason', '') == reason &&
          !afterData.keys().hasAny(['cancellationReason'])) ||
        (nextStatus == 'CANCELLED' &&
          reason is string &&
          reason.size() >= 5 &&
          afterData.get('cancellationReason', '') == reason &&
          !afterData.keys().hasAny(['rejectionReason'])) ||
        (nextStatus != 'REJECTED' &&
          nextStatus != 'CANCELLED' &&
          !event.keys().hasAny(['reason']) &&
          !afterData.keys().hasAny(['rejectionReason', 'cancellationReason']));
    }

    function validCoordinatorCaseStatusUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousStatus = resource.data.get('status', '');
      let nextStatus = request.resource.data.get('status', '');
      let eventId = request.resource.data.get('lastLifecycleEventId', '');
      let history = request.resource.data.get('lifecycleHistory', {});
      let event = history.get(eventId, {});
      return isAdmin() &&
        changedKeys.hasOnly([
          'status',
          'updatedAt',
          'lifecycleHistory',
          'lastLifecycleEventId',
          'rejectionReason',
          'cancellationReason'
        ]) &&
        changedKeys.hasAll(['status', 'updatedAt', 'lifecycleHistory', 'lastLifecycleEventId']) &&
        request.resource.data.get('updatedAt', null) == request.time &&
        validCaseLifecycleTransition(previousStatus, nextStatus) &&
        validHistoryAppend(
          resource.data,
          request.resource.data,
          'lifecycleHistory',
          eventId,
          'case_status',
          previousStatus,
          nextStatus
        ) &&
        validCaseLifecycleReason(request.resource.data, event, nextStatus);
    }

    function validCoordinatorRequestStatusUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousStatus = resource.data.get('status', '');
      let nextStatus = request.resource.data.get('status', '');
      let eventId = request.resource.data.get('lastStatusEventId', '');
      let history = request.resource.data.get('statusHistory', {});
      let event = history.get(eventId, {});
      let reason = event.get('reason', '');
      return isAdmin() &&
        nextStatus in ['REJECTED', 'CANCELLED'] &&
        !(previousStatus in ['REJECTED', 'CANCELLED', 'COMPLETED', 'rejected', 'cancelled', 'completed']) &&
        changedKeys.hasOnly([
          'status',
          'updatedAt',
          'statusHistory',
          'lastStatusEventId',
          'rejectionReason',
          'cancellationReason'
        ]) &&
        changedKeys.hasAll(['status', 'updatedAt', 'statusHistory', 'lastStatusEventId']) &&
        request.resource.data.get('updatedAt', null) == request.time &&
        validHistoryAppend(
          resource.data,
          request.resource.data,
          'statusHistory',
          eventId,
          'request_status',
          previousStatus,
          nextStatus
        ) &&
        event.get('requestId', '') == resource.data.get('requestId', '') &&
        event.get('resourceType', '') == resource.data.get('resourceType', '') &&
        reason is string &&
        reason.size() >= 5 &&
        ((nextStatus == 'REJECTED' &&
          request.resource.data.get('rejectionReason', '') == reason &&
          !request.resource.data.keys().hasAny(['cancellationReason'])) ||
         (nextStatus == 'CANCELLED' &&
          request.resource.data.get('cancellationReason', '') == reason &&
          !request.resource.data.keys().hasAny(['rejectionReason'])));
    }

    function validAssignmentAudit(requestId, auditId) {
      let requestPath = /databases/$(database)/documents/requests/$(requestId);
      let auditPath = /databases/$(database)/documents/requests/$(requestId)/assignmentHistory/$(auditId);
      let previousRequest = get(requestPath).data;
      let updatedRequest = getAfter(requestPath).data;
      let audit = getAfter(auditPath).data;
      return isAdmin() &&
        exists(requestPath) &&
        existsAfter(requestPath) &&
        existsAfter(auditPath) &&
        updatedRequest.get('lastAssignmentAuditId', '') == auditId &&
        updatedRequest.get('assignmentCoordinatorUid', '') == request.auth.uid &&
        updatedRequest.get('assignedAt', null) == request.time &&
        updatedRequest.get('providerUid', '') != previousRequest.get('providerUid', '') &&
        audit.get('requestId', '') == requestId &&
        audit.get('caseId', '') == previousRequest.get('caseId', '') &&
        audit.get('resourceType', '') == previousRequest.get('resourceType', '') &&
        audit.get('previousProviderUid', '') == previousRequest.get('providerUid', '') &&
        audit.get('previousProviderName', '') == previousRequest.get('providerName', '') &&
        audit.get('newProviderUid', '') == updatedRequest.get('providerUid', '') &&
        audit.get('newProviderName', '') == updatedRequest.get('providerName', '') &&
        audit.get('coordinatorUid', '') == request.auth.uid &&
        audit.get('timestamp', null) == request.time &&
        audit.get('reason', '') is string &&
        (previousRequest.get('providerUid', '') == '' ||
         audit.get('reason', '').size() >= 5) &&
        validAssignmentProvider(updatedRequest.get('providerUid', ''), previousRequest.get('resourceType', ''));
    }

    function validAssignmentUpdate(requestId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousStatus = resource.data.get('status', '');
      let nextStatus = request.resource.data.get('status', '');
      let statusEventId = request.resource.data.get('lastStatusEventId', '');
      let statusChanged = previousStatus != 'ASSIGNED';
      let assignmentNotificationPath = /databases/$(database)/documents/notifications/$(request.resource.data.get('lastAssignmentAuditId', '') + '_' + request.resource.data.get('providerUid', ''));
      return isAdmin() &&
        changedKeys.hasOnly([
          'providerUid',
          'providerName',
          'assignedAt',
          'assignmentCoordinatorUid',
          'lastAssignmentAuditId',
          'updatedAt',
          'status',
          'statusHistory',
          'lastStatusEventId',
          'respondedByUid',
          'respondedAt',
          'responseDetails',
          'rejectionReason',
          'cancellationReason'
        ]) &&
        changedKeys.hasAll([
          'providerUid',
          'providerName',
          'assignedAt',
          'assignmentCoordinatorUid',
          'lastAssignmentAuditId',
          'updatedAt'
        ]) &&
        request.resource.data.get('patientUid', '') == resource.data.get('patientUid', '') &&
        request.resource.data.get('caseId', '') == resource.data.get('caseId', '') &&
        request.resource.data.get('resourceType', '') == resource.data.get('resourceType', '') &&
        nextStatus == 'ASSIGNED' &&
        (statusChanged
          ? validRequestLifecycleTransition(previousStatus, nextStatus) &&
            validHistoryAppend(
              resource.data,
              request.resource.data,
              'statusHistory',
              statusEventId,
              'request_status',
              previousStatus,
              nextStatus
            )
          : nextStatus == previousStatus &&
            request.resource.data.get('statusHistory', {}) == resource.data.get('statusHistory', {}) &&
            request.resource.data.get('lastStatusEventId', '') == resource.data.get('lastStatusEventId', '')) &&
        request.resource.data.get('providerUid', '') != resource.data.get('providerUid', '') &&
        request.resource.data.get('assignmentCoordinatorUid', '') == request.auth.uid &&
        request.resource.data.get('assignedAt', null) == request.time &&
        request.resource.data.get('updatedAt', null) == request.time &&
        request.resource.data.get('lastAssignmentAuditId', '') is string &&
        !request.resource.data.keys().hasAny([
          'respondedByUid',
          'respondedAt',
          'responseDetails',
          'rejectionReason',
          'cancellationReason'
        ]) &&
        validAssignmentAudit(requestId, request.resource.data.get('lastAssignmentAuditId', '')) &&
        existsAfter(assignmentNotificationPath) &&
        getAfter(assignmentNotificationPath).data.get('recipientUid', '') == request.resource.data.get('providerUid', '') &&
        getAfter(assignmentNotificationPath).data.get('createdAt', null) == request.time;
    }

    function validProviderResponseUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let responseStatus = request.resource.data.get('status', '');
      let responseDetails = request.resource.data.get('responseDetails', '');
      let statusEventId = request.resource.data.get('lastStatusEventId', '');
      let responseNotificationPath = /databases/$(database)/documents/notifications/$(statusEventId + '_' + resource.data.get('assignmentCoordinatorUid', ''));
      return isSignedIn() &&
        resource.data.get('providerUid', '') == request.auth.uid &&
        validAssignmentProvider(request.auth.uid, resource.data.get('resourceType', '')) &&
        resource.data.get('status', '') in ['pending', 'assigned', 'requested', 'ASSIGNED', 'REQUESTED'] &&
        responseStatus in ['ACCEPTED', 'REJECTED'] &&
        changedKeys.hasOnly([
          'status',
          'respondedByUid',
          'responseDetails',
          'rejectionReason',
          'respondedAt',
          'updatedAt',
          'statusHistory',
          'lastStatusEventId'
        ]) &&
        changedKeys.hasAll([
          'status',
          'respondedByUid',
          'responseDetails',
          'respondedAt',
          'updatedAt',
          'statusHistory',
          'lastStatusEventId'
        ]) &&
        request.resource.data.get('providerUid', '') == resource.data.get('providerUid', '') &&
        request.resource.data.get('patientUid', '') == resource.data.get('patientUid', '') &&
        request.resource.data.get('requesterUid', '') == resource.data.get('requesterUid', '') &&
        request.resource.data.get('caseId', '') == resource.data.get('caseId', '') &&
        request.resource.data.get('resourceType', '') == resource.data.get('resourceType', '') &&
        request.resource.data.get('assignmentCoordinatorUid', '') == resource.data.get('assignmentCoordinatorUid', '') &&
        request.resource.data.get('respondedByUid', '') == request.auth.uid &&
        request.resource.data.get('respondedAt', null) == request.time &&
        request.resource.data.get('updatedAt', null) == request.time &&
        validRequestLifecycleTransition(resource.data.get('status', ''), responseStatus) &&
        validHistoryAppend(
          resource.data,
          request.resource.data,
          'statusHistory',
          statusEventId,
          'request_status',
          resource.data.get('status', ''),
          responseStatus
        ) &&
        request.resource.data.get('statusHistory', {}).get(statusEventId, {}).get('requestId', '') ==
          resource.data.get('requestId', '') &&
        request.resource.data.get('statusHistory', {}).get(statusEventId, {}).get('resourceType', '') ==
          resource.data.get('resourceType', '') &&
        responseDetails is string &&
        ((responseStatus == 'ACCEPTED' &&
          responseDetails == 'Accepted by provider.' &&
          !request.resource.data.keys().hasAny(['rejectionReason'])) ||
         (responseStatus == 'REJECTED' &&
          changedKeys.hasAny(['rejectionReason']) &&
          request.resource.data.get('rejectionReason', '') is string &&
          request.resource.data.get('rejectionReason', '').size() >= 5 &&
          responseDetails == request.resource.data.get('rejectionReason', ''))) &&
        existsAfter(responseNotificationPath) &&
        getAfter(responseNotificationPath).data.get('eventId', '') == statusEventId &&
        getAfter(responseNotificationPath).data.get('createdAt', null) == request.time;
    }

    function validProviderResponseNotification(notificationId) {
      let requestId = request.resource.data.get('relatedRequestId', '');
      let requestPath = /databases/$(database)/documents/requests/$(requestId);
      let previousRequest = get(requestPath).data;
      let updatedRequest = getAfter(requestPath).data;
      let notificationType = request.resource.data.get('type', '');
      return isSignedIn() &&
        requestId is string &&
        requestId.size() > 0 &&
        previousRequest.get('providerUid', '') == request.auth.uid &&
        previousRequest.get('status', '') in ['pending', 'assigned', 'requested', 'ASSIGNED', 'REQUESTED'] &&
        previousRequest.get('assignmentCoordinatorUid', '') is string &&
        previousRequest.get('assignmentCoordinatorUid', '').size() > 0 &&
        updatedRequest.get('providerUid', '') == request.auth.uid &&
        updatedRequest.get('respondedByUid', '') == request.auth.uid &&
        updatedRequest.get('respondedAt', null) == request.time &&
        updatedRequest.get('lastStatusEventId', '') == request.resource.data.get('eventId', '') &&
        updatedRequest.get('assignmentCoordinatorUid', '') == request.resource.data.get('recipientUid', '') &&
        request.resource.data.get('recipientUid', '') is string &&
        request.resource.data.get('recipientUid', '').size() > 0 &&
        request.resource.data.get('eventType', '') == 'provider_response' &&
        notificationId == request.resource.data.get('eventId', '') + '_' + request.resource.data.get('recipientUid', '') &&
        request.resource.data.get('emergencyId', '') == previousRequest.get('caseId', '') &&
        request.resource.data.get('relatedCaseId', '') == previousRequest.get('caseId', '') &&
        request.resource.data.get('resourceType', '') == previousRequest.get('resourceType', '') &&
        request.resource.data.get('actorUid', '') == request.auth.uid &&
        request.resource.data.get('responseProviderUid', '') == request.auth.uid &&
        request.resource.data.get('details', '') == updatedRequest.get('responseDetails', '') &&
        request.resource.data.get('createdAt', null) == request.time &&
        request.resource.data.get('isRead', false) == false &&
        ((updatedRequest.get('status', '') == 'ACCEPTED' &&
          notificationType == 'request_accepted') ||
         (updatedRequest.get('status', '') == 'REJECTED' &&
          notificationType == 'request_rejected')) &&
        updatedRequest.get('statusHistory', {}) != previousRequest.get('statusHistory', {});
    }

    function validAssignmentNotification(notificationId) {
      let requestId = request.resource.data.get('relatedRequestId', '');
      let requestPath = /databases/$(database)/documents/requests/$(requestId);
      let previousRequest = get(requestPath).data;
      let updatedRequest = getAfter(requestPath).data;
      let eventId = request.resource.data.get('eventId', '');
      let auditPath = /databases/$(database)/documents/requests/$(requestId)/assignmentHistory/$(eventId);
      let audit = getAfter(auditPath).data;
      return isAdmin() &&
        requestId is string &&
        requestId.size() > 0 &&
        eventId is string &&
        eventId.size() > 0 &&
        notificationId == eventId + '_' + request.resource.data.get('recipientUid', '') &&
        updatedRequest.get('lastAssignmentAuditId', '') == eventId &&
        updatedRequest.get('providerUid', '') != previousRequest.get('providerUid', '') &&
        updatedRequest.get('providerUid', '') == request.resource.data.get('recipientUid', '') &&
        updatedRequest.get('assignmentCoordinatorUid', '') == request.auth.uid &&
        updatedRequest.get('assignedAt', null) == request.time &&
        updatedRequest.get('status', '') == 'ASSIGNED' &&
        audit.get('requestId', '') == requestId &&
        audit.get('coordinatorUid', '') == request.auth.uid &&
        audit.get('newProviderUid', '') == updatedRequest.get('providerUid', '') &&
        audit.get('timestamp', null) == request.time &&
        request.resource.data.get('type', '') == 'request_assigned' &&
        request.resource.data.get('eventType', '') == 'request_assignment' &&
        request.resource.data.get('emergencyId', '') == previousRequest.get('caseId', '') &&
        request.resource.data.get('relatedCaseId', '') == previousRequest.get('caseId', '') &&
        request.resource.data.get('relatedRequestId', '') == requestId &&
        request.resource.data.get('resourceType', '') == previousRequest.get('resourceType', '') &&
        request.resource.data.get('actorUid', '') == request.auth.uid &&
        request.resource.data.get('createdAt', null) == request.time &&
        request.resource.data.get('isRead', false) == false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['uid', 'role', 'isVerified', 'isActive']) &&
        request.resource.data.uid == userId &&
        request.resource.data.role != 'admin' &&
        (!isProviderRole(request.resource.data.role) || request.resource.data.isVerified == false);
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'displayName',
           'phone',
           'city',
           'state',
           'address',
           'profileComplete',
           'updatedAt',
           'hospitalAffiliation'
         ]) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isVerified == resource.data.isVerified &&
         request.resource.data.isActive == resource.data.isActive);
      allow delete: if isAdmin();

      match /attendants/{attendantUid} {
        allow get: if isOwner(userId) ||
          (isSignedIn() &&
           request.auth.uid == attendantUid &&
           resource.data.get('attendantUid', '') == request.auth.uid &&
           resource.data.get('activeConsent', false) == true);
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isAuthorizedPatient(userId) &&
          request.resource.data.keys().hasAll(['patientUid', 'attendantUid', 'activeConsent']) &&
          request.resource.data.patientUid == userId &&
          request.resource.data.attendantUid == attendantUid &&
          request.resource.data.activeConsent == true &&
          attendantUid != userId &&
          exists(userPath(attendantUid)) &&
          isAttendantRole(get(userPath(attendantUid)).data.get('role', ''));
        allow update: if isAuthorizedPatient(userId) &&
          resource.data.get('patientUid', '') == userId &&
          resource.data.get('attendantUid', '') == attendantUid &&
          request.resource.data.get('patientUid', '') == userId &&
          request.resource.data.get('attendantUid', '') == attendantUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activeConsent',
            'grantedAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'uid',
            'token',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll(['uid', 'token', 'createdAt', 'updatedAt']) &&
          request.resource.data.get('uid', '') == userId &&
          request.resource.data.get('token', '') is string &&
          request.resource.data.get('token', '').size() > 0 &&
          request.resource.data.get('updatedAt', null) == request.time &&
          request.resource.data.get('createdAt', null) == request.time;
        allow update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'uid',
            'token',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll(['uid', 'token', 'createdAt', 'updatedAt']) &&
          request.resource.data.get('uid', '') == userId &&
          request.resource.data.get('token', '') is string &&
          request.resource.data.get('token', '').size() > 0 &&
          request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
          request.resource.data.get('updatedAt', null) == request.time;
        allow delete: if isOwner(userId);
      }

      match /notificationPreferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          preferenceId == 'settings' &&
          request.resource.data.keys().hasOnly([
            'pushEnabled',
            'emergencyStatus',
            'requestAssignments',
            'providerResponses',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'pushEnabled',
            'emergencyStatus',
            'requestAssignments',
            'providerResponses',
            'updatedAt'
          ]) &&
          request.resource.data.get('pushEnabled', false) is bool &&
          request.resource.data.get('emergencyStatus', false) is bool &&
          request.resource.data.get('requestAssignments', false) is bool &&
          request.resource.data.get('providerResponses', false) is bool &&
          request.resource.data.get('updatedAt', null) == request.time;
        allow delete: if isOwner(userId) && preferenceId == 'settings';
      }
    }

    match /{path=**}/attendants/{attendantUid} {
      allow list: if isSignedIn() &&
        resource.data.get('attendantUid', '') == request.auth.uid &&
        resource.data.get('activeConsent', false) == true;
    }

    match /patientLinks/{linkId} {
      allow get: if isAdmin() ||
        (isSignedIn() &&
         (resource.data.get('attendantUid', '') == request.auth.uid ||
          resource.data.get('patientUid', '') == request.auth.uid));
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.get('attendantUid', '') == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll([
          'attendantUid',
          'patientUid',
          'consentGranted',
          'consentStatus'
        ]) &&
        request.resource.data.attendantUid is string &&
        request.resource.data.patientUid is string &&
        linkId == request.resource.data.attendantUid + '_' + request.resource.data.patientUid &&
        (request.auth.uid == request.resource.data.patientUid || isAdmin()) &&
        request.resource.data.consentGranted == true &&
        request.resource.data.consentStatus == 'granted';
      allow update: if isAdmin() ||
        (isOwner(resource.data.get('patientUid', '')) &&
         request.resource.data.get('attendantUid', '') == resource.data.get('attendantUid', '') &&
         request.resource.data.get('patientUid', '') == resource.data.get('patientUid', '') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'consentGranted',
           'consentStatus',
           'consentDate',
           'updatedAt'
         ]));
      allow delete: if isAdmin() || isOwner(resource.data.get('patientUid', ''));
    }

    match /providerDirectory/{providerUid} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() ||
        (isOwner(providerUid) &&
         isProviderRole(getUserData().get('role', '')) &&
         request.resource.data.get('uid', '') == providerUid &&
         request.resource.data.get('role', '') == getUserData().get('role', '') &&
         request.resource.data.get('isVerified', false) == getUserData().get('isVerified', false) &&
         request.resource.data.get('isActive', false) == getUserData().get('isActive', false));
      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow get: if isSignedIn() &&
        (!exists(/databases/$(database)/documents/cases/$(caseId)) ||
         canReadCase(resource.data));
      allow list: if isSignedIn() && canReadCase(resource.data);
      allow create: if (isAdmin() && request.resource.data.get('caseId', '') == caseId) ||
        (request.resource.data.get('caseId', '') == caseId &&
         request.resource.data.get('status', '') == 'REQUESTED' &&
         canSubmitForPatient(request.resource.data.get('patientUid', '')) &&
         (isAuthorizedPatient(request.resource.data.get('patientUid', '')) ||
          (request.resource.data.get('requesterUid', '') == request.auth.uid &&
           (request.resource.data.get('attendantUid', '') == request.auth.uid ||
            request.resource.data.get('attendant', {}).get('uid', '') == request.auth.uid))));
      allow update: if validCoordinatorCaseStatusUpdate();
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow get: if isSignedIn() &&
        (isAdmin() ||
         resource.data.get('patientUid', '') == request.auth.uid ||
         isAuthorizedAttendantForPatient(resource.data.get('patientUid', '')) ||
         (resource.data.get('providerUid', '') == request.auth.uid &&
          providerIsVerifiedAndActive(request.auth.uid)));
      allow list: if isSignedIn() &&
        (isAdmin() ||
         resource.data.get('patientUid', '') == request.auth.uid ||
         isAuthorizedAttendantForPatient(resource.data.get('patientUid', '')) ||
         (resource.data.get('providerUid', '') == request.auth.uid &&
          providerIsVerifiedAndActive(request.auth.uid)));
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll([
          'patientUid',
          'requesterUid',
          'caseId',
          'resourceType',
          'providerUid',
          'status'
        ]) &&
        request.resource.data.get('requesterUid', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'REQUESTED' &&
        existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)) &&
        getAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.get('patientUid', '') ==
          request.resource.data.get('patientUid', '') &&
        getAfter(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.get('requesterUid', '') ==
          request.auth.uid &&
        canSubmitForPatient(request.resource.data.get('patientUid', '')) &&
        canReceiveResourceRequest(
          request.resource.data.get('providerUid', ''),
          request.resource.data.get('resourceType', '')
        );
      allow update: if validAssignmentUpdate(requestId) ||
        validProviderResponseUpdate() ||
        validCoordinatorRequestStatusUpdate();
      allow delete: if isAdmin();

      match /assignmentHistory/{auditId} {
        allow get, list: if isSignedIn() &&
          exists(/databases/$(database)/documents/requests/$(requestId)) &&
          (isAdmin() ||
           get(/databases/$(database)/documents/requests/$(requestId)).data.get('patientUid', '') == request.auth.uid ||
           isAuthorizedAttendantForPatient(
             get(/databases/$(database)/documents/requests/$(requestId)).data.get('patientUid', '')
           ) ||
           (get(/databases/$(database)/documents/requests/$(requestId)).data.get('providerUid', '') == request.auth.uid &&
            providerIsVerifiedAndActive(request.auth.uid)));
        allow create: if validAssignmentAudit(requestId, auditId);
        allow update, delete: if false;
      }
    }

    match /hospitalProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /bloodBankProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /oxygenProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /ambulanceProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /ambulanceTrips/{tripId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow get: if isSignedIn() &&
        (!exists(/databases/$(database)/documents/notifications/$(notifId)) ||
         resource.data.get('recipientUid', '') == request.auth.uid);
      allow list: if isSignedIn() &&
        resource.data.get('recipientUid', '') == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.get('recipientUid', '') == request.auth.uid &&
        request.resource.data.get('recipientUid', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.get('isRead', false) is bool;
      allow create: if (request.resource.data.get('type', '') in ['request_accepted', 'request_rejected'] &&
          validProviderResponseNotification(notifId)) ||
        (request.resource.data.get('type', '') == 'request_assigned' &&
          validAssignmentNotification(notifId));
      allow delete: if isAdmin();
    }

    match /notifications/{notifId}/pushDeliveries/{tokenId} {
      allow read, write: if false;
    }

    match /clinicalNotes/{noteId} {
      allow read, write: if isSignedIn();
    }
  }
}
